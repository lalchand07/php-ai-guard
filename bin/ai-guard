#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}
if (!class_exists(\PhpAiGuard\Cli\Application::class)) {
    fwrite(STDERR, "Cannot find Composer's autoloader. Run composer install.\n");
    exit(1);
}

exit((new \PhpAiGuard\Cli\Application())->run($argv));
